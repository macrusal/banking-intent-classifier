{
  "uid": "banking-intent-api",
  "title": "Banking Intent API",
  "description": "Taxa de requisições, latência p95 e taxa de erro da API de classificação de intenções.",
  "tags": ["banking-intent", "api"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Taxa de requisições",
      "description": "Requisições por segundo, por endpoint: rate sobre http_requests_total. O scrape do /metrics não entra na conta.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "banking-intent-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "banking-intent-prometheus" },
          "expr": "sum by (endpoint) (rate(http_requests_total[$__rate_interval]))",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latência p95 — POST /predict",
      "description": "histogram_quantile(0.95) sobre http_request_duration_seconds, agregado por le. Medida no servidor: validação, inferência e serialização, sem a rede até o cliente. Estimativa limitada pela largura do bucket (0,25 ms entre 1 e 3 ms).",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "banking-intent-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "banking-intent-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{endpoint=\"/predict\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Taxa de erro (5xx)",
      "description": "Razão entre requisições com status_code 5xx e o total, derivada de http_requests_total. Sem tráfego, exibe 0 em vez de 0/0.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "banking-intent-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "banking-intent-prometheus" },
          "expr": "(sum(rate(http_requests_total{status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / (sum(rate(http_requests_total[$__rate_interval])) > 0) or vector(0)",
          "legendFormat": "erro 5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "single" }
      }
    }
  ]
}
